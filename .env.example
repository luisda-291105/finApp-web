# ──────────────────────────────────────────────────────────
# Variables de entorno para finApp-web (Docker)
# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────

# ID OAuth de aplicación web en Google Cloud (Gmail API)
VITE_GOOGLE_CLIENT_ID=1064872593009-3arpd7098fqkrutcp5ut8pr2i7225jbk.apps.googleusercontent.com

# URL base del backend (debe incluir protocolo y puerto)
# Ejemplos:
#   http://localhost:8080
#   http://192.168.1.100:8080
VITE_API_BASE_URL=http://localhost:8080

# Puerto del servidor de desarrollo (Vite hot-reload)
DEV_PORT=5173

# Puerto del servidor de producción (Nginx)
PROD_PORT=3000
